# Copy this file to .env and fill in real values.

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://sats_user:sats_password@localhost:5432/sats_db
#
# Leave DATABASE_URL unset (or empty) to fall back to a local SQLite database
# at instance/sats.db — useful for local development without Postgres.
DATABASE_URL=

# Session
SESSION_LIFETIME_MINUTES=120
